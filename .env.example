# URL API GREEN-API. У каждого инстанса свой кластер — проверьте в личном кабинете.
# Пример: https://3100.api.green-api.com
VITE_GREEN_API_URL=https://api.green-api.com

# Интервал опроса входящих уведомлений в миллисекундах
VITE_POLL_INTERVAL_MS=5000

# Включить демо-режим с mock-данными вместо реального GREEN-API
# Используйте true для локального демо/деплоя и false для реальной работы
VITE_USE_MOCK=false